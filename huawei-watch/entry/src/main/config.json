{
  "app": {
    "bundleName": "com.example.padelscore",
    "vendor": "example",
    "version": {
      "code": 1000000,
      "name": "1.0.0"
    }
  },
  "deviceConfig": {},
  "module": {
    "deviceType": [
      "liteWearable"
    ],
    "reqPermissions": [
      {
        "name": "ohos.permission.READ_HEALTH_DATA"
      }
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [
      {
        "name": ".MainAbility",
        "srcLanguage": "js",
        "srcPath": "default",
        "icon": "$media:icon",
        "description": "$string:MainAbility_desc",
        "label": "$string:MainAbility_label",
        "type": "page",
        "visible": true
      }
    ],
    "js": [
      {
        "name": ".MainAbility",
        "pages": [
          "pages/index/index"
        ],
        "window": {
          "designWidth": 408,
          "autoDesignWidth": false
        }
      }
    ]
  }
}
