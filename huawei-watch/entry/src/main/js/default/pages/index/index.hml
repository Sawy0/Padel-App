<div class="root" onkey="onKey">

  <!-- ============ SCORE ============ -->
  <stack class="view" if="{{isMatch}}">
    <div class="view">
      <div class="top">
        <text class="sets">{{setsLine}}</text>
      </div>
      <div class="panels">
        <div class="panel me" onclick="tapMe">
          <text class="who dark">YOU</text>
          <text class="pts dark">{{p0}}</text>
          <text class="games dark">Games {{g0}}</text>
        </div>
        <div class="panel opp" onclick="tapOpp">
          <text class="who">THEM</text>
          <text class="pts">{{p1}}</text>
          <text class="games">Games {{g1}}</text>
        </div>
      </div>
      <div class="status">
        <text class="note">{{note}}</text>
        <div class="undo" onclick="undo"><text class="bt">UNDO</text></div>
      </div>
      <div class="strip" onclick="goSession">
        <text class="drill">{{stripLine}}</text>
      </div>
    </div>

    <!-- golden point popup -->
    <div class="overlay" if="{{pendingGolden}}">
      <text class="ovTitle">Deuce again</text>
      <text class="ovSub">Play golden point?</text>
      <div class="ovRow">
        <div class="btn yes" onclick="goldenYes"><text class="bt dark">GOLDEN</text></div>
        <div class="btn no" onclick="goldenNo"><text class="bt">ADVANTAGE</text></div>
      </div>
    </div>

    <!-- match finished -->
    <div class="overlay" if="{{over}}">
      <text class="ovTitle">{{overText}}</text>
      <text class="ovSub">{{overScore}}</text>
      <div class="ovRow">
        <div class="btn no" onclick="undo"><text class="bt">UNDO</text></div>
        <div class="btn yes" onclick="newMatch"><text class="bt dark">NEW MATCH</text></div>
      </div>
    </div>
  </stack>

  <!-- ============ WIN RATE ============ -->
  <div class="view page" if="{{isStats}}">
    <text class="h1">WIN RATE</text>
    <text class="big">{{rate}}</text>
    <text class="line">{{record}}   ({{matches}} matches)</text>
    <text class="line">Form (latest first): {{form}}</text>
    <text class="line">Streak: {{streak}}</text>
    <text class="line">Points won: {{ptsRate}}</text>
    <text class="line">Games won: {{gamesRate}}</text>
    <text class="link" onclick="clearHistory">{{clearText}}</text>
  </div>

  <!-- ============ SESSION (heart rate / calories) ============ -->
  <div class="view page" if="{{isSession}}">
    <text class="h1">FITNESS SESSION</text>
    <div class="tiles">
      <div class="tile"><text class="tv">{{sesHr}}</text><text class="tk">HEART RATE</text></div>
      <div class="tile"><text class="tv">{{sesKcal}}</text><text class="tk">KCAL (est.)</text></div>
    </div>
    <text class="blk">{{sesTime}}</text>
    <text class="line dim">Avg {{sesAvg}}   Max {{sesMax}} bpm</text>
    <text class="line dim">{{sesNote}}</text>
    <div class="solo">
      <div class="btn yes" onclick="sessionToggle"><text class="bt dark">{{sesBtn}}</text></div>
    </div>
  </div>

  <!-- ============ SETTINGS ============ -->
  <div class="view page" if="{{isSettings}}">
    <text class="h1">SETTINGS</text>
    <div class="row" onclick="tSets"><text class="k">Match</text><text class="v">{{setSets}}</text></div>
    <div class="row" onclick="tGolden"><text class="k">Golden point</text><text class="v">{{setGolden}}</text></div>
    <div class="row" onclick="tFinal"><text class="k">Final set</text><text class="v">{{setFinal}}</text></div>
    <div class="row" onclick="tGps"><text class="k">Games per set</text><text class="v">{{setGps}}</text></div>
    <div class="row" onclick="tTb"><text class="k">Tie-break</text><text class="v">{{setTb}}</text></div>
    <text class="link" onclick="goProfile">More &gt;</text>
  </div>
  <div class="view page" if="{{isProfile}}">
    <text class="h1">MORE</text>
    <div class="row" onclick="tHaptics"><text class="k">Vibration</text><text class="v">{{setHaptics}}</text></div>
    <div class="row" onclick="assignKey"><text class="k">My button</text><text class="v">{{setKey}}</text></div>
    <div class="row" onclick="tAge"><text class="k">Age</text><text class="v">{{setAge}}</text></div>
    <div class="row" onclick="tWeight"><text class="k">Weight</text><text class="v">{{setWeight}}</text></div>
    <div class="row" onclick="tSex"><text class="k">Sex</text><text class="v">{{setSex}}</text></div>
    <text class="link" onclick="clearKey">Unassign my button</text>
    <text class="link" onclick="goSettings">&lt; Back</text>
  </div>

  <!-- ============ TAB BAR ============ -->
  <!-- Lite Wearable can't bind class names, so each tab has an active and an idle variant. -->
  <div class="tabs">
    <div class="tab on" if="{{isMatch}}" onclick="goMatch"><text class="tt dark">SCORE</text></div>
    <div class="tab" if="{{!isMatch}}" onclick="goMatch"><text class="tt">SCORE</text></div>
    <div class="tab on" if="{{isStats}}" onclick="goStats"><text class="tt dark">WIN %</text></div>
    <div class="tab" if="{{!isStats}}" onclick="goStats"><text class="tt">WIN %</text></div>
    <div class="tab on" if="{{isSession}}" onclick="goSession"><text class="tt dark">FIT</text></div>
    <div class="tab" if="{{!isSession}}" onclick="goSession"><text class="tt">FIT</text></div>
    <div class="tab on" if="{{isSettings || isProfile}}" onclick="goSettings"><text class="tt dark">SET</text></div>
    <div class="tab" if="{{!(isSettings || isProfile)}}" onclick="goSettings"><text class="tt">SET</text></div>
  </div>
</div>
